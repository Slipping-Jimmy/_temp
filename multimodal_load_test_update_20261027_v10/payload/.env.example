# Required. Never commit a real token.
PLAYGROUND_BASE_URL=http://192.168.8.144:40030
PLAYGROUND_TOKEN=replace-with-a-new-short-lived-test-token

# Dataset and workload.
DATASET_DIR=./data/tono
IMAGE_MANIFEST=./images_manifest.csv
QUESTION_FILE=./questions.json
PROMPT_PROFILE=short

# Gemma 4 31B: presence_penalty=0.2 is experimental; frequency_penalty is omitted.
# Passed to the playground API as llm_argument; backend must support/forward it.
# Missing keys use these defaults. This is requested config, not server confirmation.
LLM_ARGUMENT_JSON='{"max_tokens":1024,"temperature":1.0,"top_p":0.95,"presence_penalty":0.2,"enable_thinking":false}'

# Reuse one conversation per Locust user; each request still gets a unique chat_id.
# Use per_request only when conversation creation is intentionally in scope.
CONVERSATION_MODE=per_user
# Optional: reuse one known conversation instead of creating conversations.
FIXED_CONVERSATION_ID=

# Used only by unthrottled_load.py. For sse-burst model/GPU capacity tests,
# per_request prepares one conversation per job before the synchronized SSE
# release, so concurrent writes to one conversation do not distort the curve.
# Use shared only when intentionally testing same-conversation write contention.
UNTHROTTLED_CONVERSATION_STRATEGY=per_request

# Load levels. Start small, then extend after the smoke run succeeds.
USERS_STEPS="1 2 4 8 16 32"
SPAWN_RATE=2
RUN_TIME=5m
STOP_TIMEOUT=30
REQUEST_TIMEOUT_SECONDS=120
# Absolute SSE wall-clock cap. Unlike socket read timeout, this still fires when
# a malformed stream keeps sending small chunks forever.
SSE_MAX_TOTAL_SECONDS=180
BETWEEN_REQUESTS_SECONDS=0

# SSE validation and retained output.
REQUIRE_DONE_MARKER=1
CAPTURE_RESPONSE=1
# Also captures timestamped SSE lines, including blank event separators, in sse_raw.jsonl.
# TTFT excludes protocol-only [answer]/[thought] prefixes; it does not imply completion.
RESPONSE_PREVIEW_CHARS=500

# Optional vLLM Prometheus endpoint reachable from the load generator.
# Example: http://192.168.8.144:8000/metrics
VLLM_METRICS_URL=
METRICS_INTERVAL_SECONDS=1

# Enable only if this script is running on the H200 host itself.
COLLECT_LOCAL_GPU=0

# Provisional offline report thresholds.
MAX_ERROR_RATE_PERCENT=1
MAX_P95_TTFT_MS=3000
MAX_P95_TOTAL_MS=10000
