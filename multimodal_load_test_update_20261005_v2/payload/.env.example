# Required. Never commit a real token.
PLAYGROUND_BASE_URL=http://192.168.8.144:40030
PLAYGROUND_TOKEN=replace-with-a-new-short-lived-test-token

# Dataset and workload.
DATASET_DIR=./data/tono
IMAGE_MANIFEST=./images_manifest.csv
QUESTION_FILE=./questions.json
PROMPT_PROFILE=short

# Reuse one conversation per Locust user; each request still gets a unique chat_id.
# Use per_request only when conversation creation is intentionally in scope.
CONVERSATION_MODE=per_user
# Optional: reuse one known conversation instead of creating conversations.
FIXED_CONVERSATION_ID=

# Load levels. Start small, then extend after the smoke run succeeds.
USERS_STEPS="1 2 4 8 16 32"
SPAWN_RATE=2
RUN_TIME=5m
STOP_TIMEOUT=30
REQUEST_TIMEOUT_SECONDS=120
BETWEEN_REQUESTS_SECONDS=0

# SSE validation and retained output.
REQUIRE_DONE_MARKER=1
CAPTURE_RESPONSE=1
RESPONSE_PREVIEW_CHARS=500

# Optional vLLM Prometheus endpoint reachable from the load generator.
# Example: http://192.168.8.144:8000/metrics
VLLM_METRICS_URL=
METRICS_INTERVAL_SECONDS=1

# Enable only if this script is running on the H200 host itself.
COLLECT_LOCAL_GPU=0

# Provisional offline report thresholds.
MAX_ERROR_RATE_PERCENT=1
MAX_P95_TTFT_MS=3000
MAX_P95_TOTAL_MS=10000
